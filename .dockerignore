# Keep credentials and local data out of the Docker image build context.
# (Runtime still sees them via the docker-compose bind mount of the project dir.)
.git
.gitignore
node_modules
backups
*.log
trae-accounts.json
trae-history.json
trae-last-data.json
trae-sync.json
trae-admin.json
wb-sync.json
credits.db
credits.db-shm
credits.db-wal
_probe.mjs
workbuddy-checkin
使用说明.txt
